<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hyperpulse.app">

    <!-- =================================================================== -->
    <!-- 1. صلاحيات الإنترنت والشبكة وتنزيل الملفات بالتوازي                   -->
    <!-- =================================================================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- =================================================================== -->
    <!-- 2. خدمات العمل في الخلفية وتنزيل الملفات الكبيرة دون انقطاع          -->
    <!-- =================================================================== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- =================================================================== -->
    <!-- 3. النوافذ المنبثقة العائمة (Overlay Bubble) لالتقاط الروابط         -->
    <!-- =================================================================== -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- =================================================================== -->
    <!-- 4. إشعارات التنزيل وسرعة النقل الحية (Android 13+)                   -->
    <!-- =================================================================== -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- =================================================================== -->
    <!-- 5. الوصول إلى الوسائط والصوتيات لـ FFmpeg (Android 13+ & Scoped Storage) -->
    <!-- =================================================================== -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- توافقية مع الإصدارات القديمة من أندرويد 10 وما قبله -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:label="HyperPulse"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- ثيم البداية التلقائي لـ Flutter -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- المشغل الرئيسي للتطبيق (Launcher) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- استقبال مشاركة الروابط من المتصفحات وتطبيقات التواصل (Send Link Intent) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- تعريف محرك تضمين Flutter V2 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
